                                                        </div>
                                                    </div>
                                                <div class="checkbox">
                                                    <label for="confirmationCotitular-checkbox" id="confirmationCotitular-label">
                                                        <input class="parpadeo" type="checkbox" id="confirmationCotitular-checkbox" name="confirmationCotitular-checkbox" aria-labelledby="confirmationCotitular-label" />
                                                        Postulante Cotitular <strong>seleccione y autocomplete</strong>
                                                    </label>
                                                </div>
                                                <div id="cajacotitular" class="form-group col-md-12 display" style="display:none;">
