                    var idInscripto = $(this).data("inscripto");                    

                    $("#AjaxLoader").show("fast");

                     $.ajax({
                             url: '@Url.Action("Adherir", "Adhesion")',
                             data: {
                                    programaId: programaId,
                                    moduloId : moduloId,
                                    insId: idInscripto,
                                    modeloDetalle : modeloDetalles,
                                    nombreCotitular : nombreCotitular,
                                    adhesionCotitularInputCuitUno : adhesionCotitularInputCuitUno,
                                    adhesionCotitularInputCuitDos : adhesionCotitularInputCuitTres,
                                    adhesionCotitularInputCuitDni : adhesionCotitularInputCuitDosDni
                             },
                             type: "get",
                             success: function (result) {
                                    //console.log(result);
                                    $("#AjaxLoader").delay(2000).hide("slow");
                                    if (result.isRedirect) {

                                        //3_rotativa_ ya no uso el escribir sobre un tag el url
                                       // $('#hrefsuces').val(result.redirectUrl);
                                        const buttonElement = document.activeElement; // Get the currently focused element
                                        buttonElement.blur(); // Remove focus from the button

                                        $("#modalAdhesion").modal('hide');
                                        $("#modalSuccessAdhesion").modal('show');
                                        // $("#btnAdhesion").prop('disabled', true);
                                         $('#btnAdhesion').addClass('disabled');
                                    } else {
                                             e.preventDefault();
                                                //  $("#modalAdhesion").modal('hide');
                                                //     var dialog = bootbox.alert({
                                                //     size: "small",
                                                //     title: "I.V.U.J.",
                                                //     message: result.ob,
                                                //     callback: function () {
                                                //         dialog.modal('hide'); // se cierra después de aceptar
                                                //     }
                                                // });
                                                $("#modalAdhesion").modal('hide');
                                                showSimpleModal(result.ob);
                                                  
                                    }
                             },
                                error: function (errormessage) {
                                    $("#AjaxLoader").delay(2000).hide("slow");
                                        e.preventDefault();

                                        // var dialog = bootbox.alert({
                                        //     size: "small",
                                        //     title: "I.V.U.J.",
                                        //     message: "Datos ingresados de forma incorrecta",
                                        //      callback: function () {
                                        //                 dialog.modal('hide'); // se cierra después de aceptar
                                        //             }
                                        // });
                                        showSimpleModalError(errormessage.ob);
                                }
                            }).done(function (result) {
                                $("#AjaxLoader").delay(2000).hide("slow");

                     });
                     
                     
                });
        });

        $(function (){
            $('#inputAdhesionTitularCuit').on('input', function () {
                var valor = $(this).val();
                // Elimina cualquier caracter que no sea número
                valor = valor.replace(/\D/g, '');
                // Aplica el formato XX-XXXXXXXX-X
                if (valor.length > 2 && valor.length <= 10) {
                    valor = valor.substring(0, 2) + '-' + valor.substring(2);
                } else if (valor.length > 10) {
                    valor = valor.substring(0, 2) + '-' + valor.substring(2, 10) + '-' + valor.substring(10, 11);
                }
                $(this).val(valor);
            });

