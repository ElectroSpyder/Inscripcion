@model ADJInsc.Models.ViewModels.InscViewModel
<!--https://www.aspsnippets.com/Articles/Editable-Table-MVC-Implement-Insert-Update-Edit-Delete-in-HTML-Table-using-ASPNet-MVC.aspx-->
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .highlighted {
        font-weight: bold;
    }

    #modalAdhesion .modal-dialog {
        max-width: 40%; /* Ajusta el porcentaje según necesites */
    }

    #confirmation-label {
        display: block; /* Convierte el label en bloque */
        text-align: justify; /* Justifica el texto */
        width: 100%; /* Asegura que ocupe todo el ancho disponible */
    }

    #fin-label {
        text-align: justify;
        display: block; /* Asegura que ocupe todo el ancho disponible */
    }

    .parpadeo {
        animation: parpadeo 1s infinite alternate;
    }
</style>
<div style="float:right;">
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10" style="display: flex; gap: 10px; align-items: center;">
            @if (string.Equals(Model.InsEstado, "I") && Model.AdhesionViewModel.Habilitar == true)
            {
                <img id="AjaxLoader" alt="Enviando ..." style="display:none; width:60px; height:60px;" src="~/image/loader.gif" />
                
                <button id="btnAdhesion" type="button" class="btn btn-outline-success" float-right" data-toggle="modal" data-target="#modalAdhesion">
                    <span>@(string.IsNullOrEmpty(Model.AdhesionViewModel.ProgramaVM.Descripcion) ? "Adhesión" : Model.AdhesionViewModel.ProgramaVM.Descripcion)</span>
                    <i class="fas fa-plus-circle"></i>
                </button>
            }
            <form asp-controller="Inscripcion" asp-action="GoHome">
                <img id="AjaxLoaderLogin" alt="Enviando ..." style="display:none; width:50px; height:50px;" src="~/image/loader.gif" />
                <button class="btn btn-outline-danger " id="btnLogin">Cerrar sesion</button>
            </form>
            <button type="submit" class="btn btn-outline-info aceptarSuccess">Descargar Declaración Jurada</button>
        </div>
    </div>
</div>

<p>
    <h2>Sistema de Inscripción / Actualización de Datos del IVUJ</h2>
    <h4>Panel de Control</h4>
</p>


<form id="formFamilia" asp-controller="Bandeja" asp-action="GuardarData">
    <div class="form-group card border-info">
        <h3 class="card-header text-light bg-info">
            Titular
            (Los campos marcados con * son obligatorios)
        </h3>
        <div class="form-group card-body">
            <div class="form-group col-md-12">
                DNI Nº (*)
                <input type="text" class="form-control" id="inputDni" placeholder="D.N.I." value="@Model.InsNumdoc" disabled>
            </div>
            <div class="form-group col-md-12">
                Apellido/s y Nombre/s (completos) (*)
                <input type="text" class="form-control" id="inputNombre" placeholder="Nombre" value="@Model.InsNombre">
            </div>
            <div class="form-group col-md-12">
                Teléfono (anteponiendo código de área) (*)
                <input type="text"
                       class="form-control"
                       id="inputTel"
                       placeholder="Teléfono"
                       onkeypress="return valideKeyNros(event);"
                       value="@Model.InsTelef">
            </div>
            <div class="form-group col-md-12">
                Estado Civil (seleccionar) (*)
                @Html.DropDownListFor(x => Model.IdTipoFamilia, Model.TipoFamiliaList ?? new List<SelectListItem>(), "----Selecciona Estado Civil----", htmlAttributes: new { @class = "form-control", id = "ddTipoFamiliaId" })
            </div>

            <div class="form-group col-md-12">Tilde lo que corresponda.:</div>
            <div class="form-inline col-md-12">
                <div class="form-check form-check-inline">

                    <input class="form-check-input" type="checkbox" id="idDis" value="@Model.InsDiscapacitado">
                    <label class="form-check-label" for="inlineCheckbox1">Persona con discapacidad</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="idMin" value="@Model.InsMinero">
                    <label class="form-check-label" for="inlineCheckbox2">Trabajador/a Minero/a </label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="idVet" value="@Model.InsVeterano">
                    <label class="form-check-label" for="inlineCheckbox3">Veterano de Malvinas</label>
                </div>
            </div>
            <br />
            <div class="form-inline col-md-6" style="width:auto; margin-bottom:1px;">



                CUIL-CUIT (*)
                <input id="inputCuitUno"
                       maxlength="2"
                       pattern="[0-9]+"
                       size="2"
                       type="text"
                       class="form-control"
                       style="width:16%; margin-left:4px;"
                       value="@Model.CuitCuilUno.Trim()"> -
                <input type="text" class="form-control" id="inputCuitDos" placeholder="D.N.I." value="@Model.InsNumdoc" disabled style="width:40%"> -

                <input id="inputCuitTres"
                       maxlength="1"
                       pattern="[0-9]+"
                       size="1"
                       type="text"
                       class="form-control"
                       style="width:16%"
                       value="@Model.CuitCuilDos.Trim()">



            </div>
        </div>
    </div>

    <div class="form-group card border-info">
        <h5 class="card-header text-light bg-info"> Dirección</h5>
        <div class="form-row card-body">
            <div class="form-group col-md-12">
                Dirección (Detalle: Calle, Número, Piso, Lote, Manzana, Barrio, Código Postal) (*)
                <input type="text"
                       multiple class="form-control"
                       id="inputAddress"
                       placeholder="Dirección"
                       onkeyup="upperCase(this);"
                       value="@Model.Direccion">
            </div>

            <div class="form-group col-md-4">
                Departamento (*) (seleccionar)
                @Html.DropDownListFor(x => Model.DepartamentoKey, Model.DepartamentosList ?? new List<SelectListItem>(), htmlAttributes: new { @class = "form-control", id = "ddDepartamentoId" })

            </div>
            <div class="form-group col-md-6">
                Localidad (*)  (seleccionar)
                @Html.DropDownListFor(x => Model.DomLocalidadKey, Model.LocalidadesList ?? new List<SelectListItem>(), htmlAttributes: new { @class = "form-control", id = "ddLocalidadId" })
            </div>
        </div>
    </div>

    <div class="form-group card border-info">
        <h5 class="card-header text-light bg-info"> Situación Laboral</h5>
        <div class="form-row card-body">
            <div class="form-group col-md-12">
                <label for="inputLugar">Lugar de empleo del/la Titular (*):</label>
                <input type="text"
                       multiple class="form-control"
                       id="inputLugar"
                       placeholder="Lugar donde trabaja"
                       onkeyup="upperCase(this);"
                       value="@Model.NombreEmpleo">
            </div>

            <div class="form-group col-md-4">
                <label for="ddTipoRevistaId">Tipo de empleo (*) (seleccionar)</label>
                @Html.DropDownListFor(x => Model.TipoRevistaKey, Model.TipoRevistaList ?? new List<SelectListItem>(), htmlAttributes: new { @class = "form-control", id = "ddTipoRevistaId" })

            </div>

            <div class="form-group col-md-8">

                <label for="inputIngresoNeto">Ingreso total del GRUPO FAMILIAR (*) (**) - Sueldo Neto (sin puntos):</label>

                <input type="number" class="form-control" id="inputIngresoNeto" value="@Model.IngresoNeto">
            </div>
            <h6 class="card-title">
                (**) En caso de que poseas más de una ocupación (sea dependiente y/o independiente),
                en “Sueldo Neto (sin puntos)” sumá todos los ingresos percibidos en tus trabajos (el que declarás, y los otros);
                además lo que sumen otros/as aportantes del grupo familiar, y colocá el total.
            </h6>
        </div>
    </div>

    <div class="form-group card border-info">

        <h5 class="card-header text-light bg-info">Datos del Grupo Familiar</h5>
        <div class="card-body">
            <button id="btnModalInicial" type="button" class="btn btn-info float-right" data-toggle="modal" data-target="#modalInicialFamilia">Agregar integrante al grupo familiar <i class="fas fa-plus-circle"></i></button>
            <div></div>
            <table id="tablaFamilia" class="table table-striped table-responsive" cellspacing="0" width="100%">
                <!--table table-sm table-striped table-hover border-bottom table table-bordered mb-0-->
                <thead>
                    <tr>

                        <th>
                            Apellido/s y Nombre/s (*)
                        </th>
                        <th>
                            DNI Nº (*)
                        </th>
                        <th>
                            Fecha Nacimiento (*)
                        </th>
                        <th>
                            Pers. Discapacidad (*)
                        </th>
                        <th>
                            Veterano Malvinas (*)
                        </th>
                        <th>
                            Trabajador/a Minero/a (*)
                        </th>
                        <th>
                            Parentesco (*)
                        </th>
                        <th>
                            #
                        </th>
                    </tr>
                </thead>
                <tbody class="tbody">
                </tbody>
            </table>

        </div>
        <div class="card-footer">
            <h6 class="card-title">
                Declaro bajo juramento que los datos indicados en el presente formulario son verdaderos
                y que el falseamiento de cualquiera de ellos será causa suficiente
                para que se deje sin efecto la inscripción como postulante que pudiera corresponderme
            </h6>
        </div>
    </div>


    <div class="form-group">
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10" style="display: flex; gap: 10px; align-items: center;">
                <img id="AjaxLoader" alt="Enviando ..." style="display:none; width:60px; height:60px;" src="~/image/loader.gif" />
                <input id="btnCreate" type="submit" value="Cerrar y enviar solicitud" class="btn btn-primary" />
            </div>
        </div>
    </div>


</form>
<p></p>


<div id="modalInicialFamilia" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Familia</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span inert>&times;</span>
                </button>
            </div>
            <div class="modal-body card">
                <div class="card-body">

                    <div class="form-group col-md-12 has-success">
                        Apellido/s y Nombre/s (completos) (*)
                        <input type="text"
                               class="form-control"
                               id="inputNombreInicial"
                               onkeyup="upperCase(this);"
                               placeholder="Apellido y Nombre">
                    </div>

                    <div class="form-group col-md-12 has-success">
                        DNI Nº (*)
                        <input type="number"
                               class="form-control"
                               id="inputDniInicial"
                               maxlength="8"
                               placeholder="D.N.I.">
                    </div>
                    <div class="form-group col-md-12 has-success">
                        <label>Fecha Nacimiento (*)</label>
                        <input type="date" class="datepicker form-control" id="inputFecNacInicial">
                        <div class="input-group-addon">
                            <span class="glyphicon glyphicon-th"></span>
                        </div>
                    </div>
                    <br />
                    <div class="form-group col-md-12">Tilde lo que corresponda. Algún miembro de su grupo familiar es :</div>
                    <div class="form-group col-md-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="idDisInicial" value="option3">
                            <label class="form-check-label" for="idDisInicial">Persona con discapacidad</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="idMinInicial" value="option3">
                            <label class="form-check-label" for="idMinInicial">Trabajador/a Minero/a</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="idVetInicial" value="option3">
                            <label class="form-check-label" for="idVetInicial">Veterano de Malvinas</label>
                        </div>
                    </div>
                    <br />
                    <div class="form-group col-md-12 has-success">
                        <label>Parentesco (seleccionar) (*)</label>
                        @Html.DropDownListFor(x => Model.ParentescoKey, Model.ParentescoList ?? new List<SelectListItem>(),
                                 htmlAttributes: new { @class = "form-control", id = "ddParentescoInicialId", onchange = "elementoSeleccionado(this)" })
                    </div>
                </div>

            </div>
            <div class="modal-footer">

                <a id="addPersonaInicialModal" class="btn btn-info btnModal" href="#">Cargar y Cerrar</a>

            </div>
        </div>
    </div>
</div>

<div id="modalAdhesion" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Model.AdhesionViewModel.ProgramaVM.Descripcion</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span inert>&times;</span>
                </button>
            </div>
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <ul class="nav nav-tabs card-header-tabs" id="bologna-list" role="tablist">
                                    <li class="nav-item">
                                        <a class="nav-link active" href="#inicio" role="tab" aria-controls="inicio" aria-selected="true">Inicio</a>
                                    </li>
                                    <li class="nav-item">
                                        @*<a class="nav-link disabled" href="#programas" id="programas-link" role="tab" aria-controls="programas" aria-selected="false">Tipología</a> *@
                                        <a class="nav-link disabled" href="#departamentos" id="departamentos-link" role="tab" aria-controls="departamentos" aria-selected="false">Departamentos</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link disabled" href="#ingresos" id="ingresos-link" role="tab" aria-controls="ingresos" aria-selected="false">Ingresos</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link disabled" href="#relacionlaboral" id="relacionlaboral-link" role="tab" aria-controls="relacionlaboral" aria-selected="false">Relación Laboral</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link disabled" href="#inmueble" id="inmueble-link" role="tab" aria-controls="inmueble" aria-selected="false">Registro de Inmueble</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link disabled" href="#finadhesion" id="finadhesion-link" role="tab" aria-controls="finadhesion" aria-selected="false">Declaración Jurada</a>
                                    </li>
                                </ul>
                            </div>
                            <div class="card-body">
                                <h4 class="card-title"></h4>
                                @*  <h6 class="card-subtitle mb-2">Carácter de declaración Jurada</h6> *@

                                <div class="tab-content mt-3">                                 


                                    @*Panel de Inicio*@
                                    <div class="tab-pane active" id="inicio" role="tabpanel">
                                        <h3 class="card-subtitle mb-2">Inicio</h3>
                                        <div class="form-group">
                                            <div class="checkbox">
                                                <label for="confirmation-checkbox" id="confirmation-label">
                                                    <input class="parpadeo" type="checkbox" id="confirmation-checkbox" name="confirmation-checkbox" aria-labelledby="confirmation-label">
                                                   @*  Se deja expresamente aclarado, que la “tipología” a seleccionar dentro del programa, corresponderá a los “ingresos”
                                                    a declarar de mi grupo familiar. Siendo la misma, mi única opción de adhesión para este Programa. *@
                                                    Acepto tener conocimiento sobre las condiciones del programa "288 Departamentos e Infraestructura en Alto Comedero"
                                                    y dejo conformidad que la presentación de información falsa o incompleta en este formulario o el incumplimiento de los requisitos informados 
                                                    en esta adhesión online, darán lugar a mi exclusión inmediata del programa.
                                                </label>
                                            </div>
                                             <div class="form-group card-body">
                                                    <div class="form-group col-md-12">
                                                        Apellido/s y Nombre/s
                                                    <input type="text" class="form-control" id="inputNombre" placeholder="Nombre" value="@Model.InsNombre" disabled>
                                                    </div>
                                                    <div class="form-group col-md-12">
                                                        Postulante Titular CUIL/T (*)
                                                       @*  <input type="text" class="form-control" id="inputAdhesionTitularCuit" placeholder="Cuit Titular" value="" /> *@
                                                    <div class="form-inline col-md-12" style="width:auto; margin-bottom:1px;">
                                                        
                                                        <input id="adhesionInputCuitUno"
                                                               maxlength="2"
                                                               pattern="[0-9]+"
                                                               size="2"
                                                               type="text"
                                                               class="form-control"
                                                               style="width:16%; margin-left:4px;"
                                                               value="@Model.CuitCuilUno.Trim()"> -
                                                        <input type="text" class="form-control" id="adhesionInputCuitDos" placeholder="D.N.I." value="@Model.InsNumdoc" disabled style="width:40%"> -

                                                        <input id="adhesionInputCuitTres"
                                                               maxlength="1"
                                                               pattern="[0-9]+"
                                                               size="1"
                                                               type="text"
                                                               class="form-control"
                                                               style="width:16%"
                                                               value="@Model.CuitCuilDos.Trim()">
                                                    </div>
                                                    </div>
                                                <div class="form-group col-md-12">
                                                    Ingrese Apellido/s y Nombre/s (completos) de Cotitular
                                                    <div class="col-md-12">
                                                       
                                                        <input type="text" style="width:75%; margin-bottom:1px;"                                                           
                                                               class="form-control parpadeo"
                                                               id="inputCotitularNombreInicial"
                                                               onkeyup="upperCase(this);"
                                                               placeholder="Apellido y Nombre">
                                                    </div>
                                                    CUIL/T de Cotitular
                                                    <div class="form-inline col-md-12" style="width:auto; margin-bottom:1px;">

                                                        <input id="adhesionCotitularInputCuitUno"
                                                               maxlength="2"
                                                               pattern="[0-9]+"
                                                               size="2"
                                                               type="text"
                                                               class="form-control parpadeo"
                                                               style="width:16%; margin-left:4px;" > -
                                                        <input maxlength="8" pattern="[0-9]+" type="text" class="form-control" id="adhesionCotitularInputCuitDosDni" placeholder="D.N.I." style="width:40%"> -

                                                        <input id="adhesionCotitularInputCuitTres"
                                                               maxlength="1"
                                                               pattern="[0-9]+"
                                                               size="1"
                                                               type="text"
                                                               class="form-control parpadeo"
                                                               style="width:16%"
                                                               >
                                                    </div>
                                                    </div>
                                            </div>

                                        </div>
                                    </div>
                                    @*Panel de Departamento*@
                                     <div class="tab-pane" id="departamentos" role="tabpanel" aria-labelledby="departamentos-tab">
                                        <h3 class="card-subtitle mb-2">Departamento</h3>
                                        
                                        <div class="display" >
                                            <h3 class="modal-title">Detalles de la unidad habitacional del programa "288 Departamentos e Infraestructura en Alto Comedero".</h3>
                                           @*  @foreach (var opcion in Model.AdhesionViewModel.ModulosVM.ToList())
                                            { *@
                                                <ul class="list-group">
                                                    <li class="list-group-item">                                                   
                                                        <strong>Costo aproximado de la unidad habitacional</strong> (Dpto. 2 habitaciones) <span>$106.000.000</span> 
                                                    </li>
                                                    <li class="list-group-item">
                                                    <p>Con un plan de financiación de hasta 25 años aproximado.</p>
                                                    </li>
                                                    <li class="list-group-item">
                                                        <p><u>Aclaración</u>: el plazo máximo de financiación puede ser menor, 
                                                            ya que el mismo se ajustará de acuerdo a la edad de las personas postulantes.
                                                            La edad límite de las personas postulantes es de 55 años.</p>
                                                    </li>

                                                
                                                <li class="list-group-item">
                                                    <strong>Monto aproximado del ahorro previo </strong> <span>$10.600.000</span>
                                                </li>
                                                    <li class="list-group-item">
                                                    <p>El ahorro previo representa el pago del 10% del costo total de la unidad habitacional 
                                                        a cancelar en un plazo de financiación máximo de 4 años, 
                                                        entre 36 a 48 cuotas aproximadas, según plazo de ejecución de obra. </p>
                                                    </li>
                                                     <li class="list-group-item">
                                                    <p><u>Aclaración</u>: luego de cancelar el 50% del "Ahorro Previo" en cuotas (entre 18 a 24 cuotas aproximadas),
                                                        se sumaran a las cuotas restantes, el valor de las cuotas correspondientes al "Plan de Financiación" de la unidad habitacional. </p>
                                                    </li>
                                                <li class="list-group-item">
                                                    <div class="checkbox">
                                                        <label for="confirmationDepto-checkbox" id="confirmatioDepto-label">
                                                            <input class="parpadeo" type="checkbox" id="confirmationDepto-checkbox" name="confirmationDepto-checkbox" aria-labelledby="confirmationDepto-label" />
                                                            Declaro que he tomado conocimiento de que los montos y tiempos informados en esta adhesión online al 
                                                            programa "288 Departamentos e Infraestructura en Alto Comedero" <strong>son costos y plazos aproximados</strong>
                                                        </label>
                                                    </div>
                                                </li>
                                                </ul>
                                            @* } *@
                                        </div>

                                    </div>

                                    @*Panel de modulos de ingresos o programa*@
                                    <div class="tab-pane" id="ingresos" role="tabpanel" aria-labelledby="ingresos-tab">
                                        <h4 class="card-subtitle mb-2">Ingresos del grupo Familiar</h4>
                                        <p>Se considera como ingreso del grupo familiar la suma total de los ingresos individuales de cada uno de los miembros que conforman el grupo familiar. </p>
                                        <h5><strong>Ingreso mínimo requeridos por grupo familiar:</strong></h5>
                                        <ul>
                                            <li>
                                                Si prevé cancelar el Ahorro Previo en un solo pago, se solicitará un <strong>Ingreso familiar mínimo de $ 1.060.000</strong>
                                            </li>
                                            <li>
                                                Si prevé cancelar solo una parte del Ahorro Previo, se solicitará un <strong>Ingreso familiar superior de entre $ 1.060.001 a $2.049.999</strong>,
                                                dependiendo el monto a entregar (*)
                                            </li>
                                            <li>
                                                Si no realiza ninguna entrega o anticipo del Ahorro Previo y lo financia entre 36 a 48 cuotas, se solicita un <strong>Ingreso familiar mínimo de $2.050.000</strong>
                                            </li>
                                        </ul>
                                        <p>
                                            (*) <u>Aclaración</u>: toda entrega o anticipo del “Ahorro Previo” a realizar reducirá el ingreso mínimo requerido por grupo familiar,
                                            y el saldo del Ahorro Previo se lo financiará entre 36 a 48 cuotas, según plazo de ejecución de obra. Para obtener más información,
                                            consulte las "Preguntas Frecuentes de Adhesión Online" en nuestro sitio web www.ivuj.gob.ar
                                        </p>
                                     </div>

                                    @*Panel de modulos de relacion laboral*@
                                    <div class="tab-pane" id="relacionlaboral" role="tabpanel" aria-labelledby="relacionlaboral-tab">
                                        <h4 class="card-subtitle mb-2">Relación Laboral</h4>
                                        <p>
                                            Relación laboral de la persona Postulante Titular
                                        </p>                                                                              
                                        <div class="dropdown">
                                            <button class="btn btn-outline-info dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                Adherir a
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                                
