            <div class="modal-header">
                <h5 class="modal-title">@Model.AdhesionViewModel.ProgramaVM.Descripcion</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span inert>&times;</span>
                </button>
            </div>
            <div class="container">
