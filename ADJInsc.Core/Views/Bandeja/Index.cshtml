                            }
                            if (result.insVeterano == 1) {
                                $("#idVet").prop('checked', true);
                            } else {
                                $("#idVet").prop('checked', false);
                            }
                            $.each(result.grupoFamiliar, function (key, item) {

                                if (item.insfEstado != "B") {
                                    var miFecha = Date.parse(item.fechaNacimiento);
                                    html += '<tr>';
