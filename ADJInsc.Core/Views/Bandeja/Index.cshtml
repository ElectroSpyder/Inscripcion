                            } else {
                                $("#idDis").prop('checked', false);
                            }
                            if (result.insMinero == 1) {
                                $("#idMin").prop('checked', true);
                            } else {
                                $("#idMin").prop('checked', false);
                            }
                            if (result.insVeterano == 1) {
                                $("#idVet").prop('checked', true);
                            } else {
